## FRP
ro.frp.pst=/dev/block/platform/13500000.dwmmc0/by-name/persistent

## OMX
# Set csc support in OMX
# If not set or set to 0, OMX will only use BT.601 colorspace.
ro.vendor.cscsupported=1

## OpenGLES
ro.opengles.version=196610

## HW Graphics
debug.egl.hw=1
debug.sf.hw=1

## RIL
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so
vendor.sec.rild.libpath2=/vendor/lib64/libsec-ril-dsds.so

# Wifi direct
wifi.direct.interface=p2p0

## --- UI Slaas & Lag Fix (Safe Fallback to SkiaGL) ---
ro.hwui.hardware.renderer=skiagl
debug.hwui.renderer=skiagl

# Force SurfaceFlinger to bypass timestamp desync 
ro.surface_flinger.use_context_priority=1
ro.surface_flinger.max_virtual_display_dimension=4096

# Disable stutter-prone automatic refresh rate changes
ro.surface_flinger.use_content_detection_for_refresh_rate=false
ro.surface_flinger.set_touch_timer_ms=0
ro.surface_flinger.set_display_type_timer_ms=0

# Ensure strict Hardware Acceleration alignment
debug.egl.hw=1
debug.sf.hw=1
persist.sys.ui.hw=true

